// Icon and version information of the Windows executables; CMakeLists.txt
// fills in the paths (the icon is the PC version's when bin/pop.ico exists).
#include <winres.h>

// The first icon in the file is the one Explorer shows.
1 ICON "@APP_ICON@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,3,0,0
 PRODUCTVERSION 0,3,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "POPSoT Recomp - Prince of Persia: The Sands of Time (Xbox), PC port"
            VALUE "ProductName", "POPSoT Recomp"
            VALUE "FileVersion", "0.3.0"
            VALUE "ProductVersion", "0.3.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// The settings a new popsot-options.ini starts from (options.c).
203 RCDATA "@DEFAULT_OPTIONS@"
